// CCF Social Media Dashboard — data model
//
// Status/platform/role columns are plain strings rather than DB enums. That started
// as a SQLite constraint and is kept deliberately: changing an allowed value is a
// code change in src/lib/workflow.ts rather than a database migration. That file is
// the single source of truth for the permitted values.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique
  // The Supabase Auth account this staff record belongs to, linked on first
  // sign-in. Null means the person has been added by an admin but has not logged
  // in yet. Passwords live in Supabase, never in this table.
  authId String? @unique
  role  String @default("EDITOR")

  ownedPosts     Post[]          @relation("PostOwner")
  approvalEvents ApprovalEvent[]

  createdAt DateTime @default(now())
}

model ContentPillar {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  sortOrder   Int     @default(0)

  posts       Post[]
  bankEntries ContentBankEntry[]
}

model Post {
  id            String    @id @default(cuid())
  title         String
  status        String    @default("IDEA")
  platform      String?
  caption       String?
  graphicStatus String    @default("NOT_STARTED")
  // Link to the finished graphic — usually a Canva export sitting in Drive.
  graphicUrl    String?
  publishDate   DateTime?

  contentPillarId String?
  contentPillar   ContentPillar? @relation(fields: [contentPillarId], references: [id])

  ownerId String?
  owner   User?   @relation("PostOwner", fields: [ownerId], references: [id])

  alumnusId String?
  alumnus   Alumnus? @relation(fields: [alumnusId], references: [id])

  bankEntryId String?
  bankEntry   ContentBankEntry? @relation(fields: [bankEntryId], references: [id])

  approvalEvents ApprovalEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishDate])
  @@index([status])
}

model ApprovalEvent {
  id         String  @id @default(cuid())
  postId     String
  post       Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  note       String?

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([postId])
}

model ContentBankEntry {
  id               String    @id @default(cuid())
  idea             String
  captionDraft     String?
  evergreen        Boolean   @default(true)
  graphicNeeded    Boolean   @default(false)
  lastPosted       DateTime?
  performanceNotes String?

  contentPillarId String?
  contentPillar   ContentPillar? @relation(fields: [contentPillarId], references: [id])

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alumnus {
  id String @id @default(cuid())
  // Stored separately so lists can sort by surname and spotlight copy can use a
  // first name alone. lastName is optional: mononyms exist, and the CSV importer
  // flags rather than invents one.
  firstName           String
  lastName            String?
  cohortYear          Int?
  currentOrganization String?
  currentRole         String?
  linkedin            String?
  // Contact details are gated to Admin/Editor — see canViewContactInfo in
  // src/lib/workflow.ts. Never select these for list views.
  personalEmail       String?
  workEmail           String?
  featuredStatus      String  @default("NOT_FEATURED")
  careerUpdates       String?
  awards              String?
  boardMemberships    String?
  storyCollected      Boolean @default(false)

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetLink {
  id       String  @id @default(cuid())
  title    String
  category String
  url      String
  notes    String?

  createdAt DateTime @default(now())
}

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  platform    String
  followers   Int?
  reach       Int?
  engagement  Int?
  impressions Int?
  clicks      Int?
  notes       String?

  createdAt DateTime @default(now())

  @@index([periodStart])
}
